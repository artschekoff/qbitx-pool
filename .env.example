# docker compose (pool container -> postgres service)
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/qbitx?sslmode=disable"

# local host-run pool example:
# DATABASE_URL="postgresql://<user>:<password>@localhost:5533/qbitx?schema=public"

# prod example:
# DATABASE_URL="postgresql://<user>:<password>@<host>:5432/<db>"
